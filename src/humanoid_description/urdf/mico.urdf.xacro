  <joint name="neck_yaw" type="revolute"><parent link="base_link"/><child link="neck_yaw_link"/><origin xyz="0.0000 0.0000 0.1100"/><axis xyz="0 0 1"/><limit lower="-1.5708" upper="1.5708" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_hip_roll" type="revolute"><parent link="l_hip_yaw_link"/><child link="l_hip_roll_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="1 0 0"/><limit lower="-0.4363" upper="0.4363" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_hip_pitch" type="revolute"><parent link="l_hip_roll_link"/><child link="l_hip_pitch_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="0.7854" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_knee" type="revolute"><parent link="l_hip_pitch_link"/><child link="l_knee_link"/><origin xyz="0.0000 0.0000 -0.0450"/><axis xyz="0 1 0"/><limit lower="0.0000" upper="2.0944" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_ankle_pitch" type="revolute"><parent link="l_knee_link"/><child link="l_ankle_pitch_link"/><origin xyz="0.0000 0.0000 -0.0450"/><axis xyz="0 1 0"/><limit lower="-0.7854" upper="0.7854" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_ankle_roll" type="revolute"><parent link="l_ankle_pitch_link"/><child link="l_ankle_roll_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="1 0 0"/><limit lower="-0.5236" upper="0.5236" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_hip_roll" type="revolute"><parent link="r_hip_yaw_link"/><child link="r_hip_roll_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="1 0 0"/><limit lower="-0.4363" upper="0.4363" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_hip_pitch" type="revolute"><parent link="r_hip_roll_link"/><child link="r_hip_pitch_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="0.7854" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_knee" type="revolute"><parent link="r_hip_pitch_link"/><child link="r_knee_link"/><origin xyz="0.0000 0.0000 -0.0450"/><axis xyz="0 1 0"/><limit lower="0.0000" upper="2.0944" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_ankle_pitch" type="revolute"><parent link="r_knee_link"/><child link="r_ankle_pitch_link"/><origin xyz="0.0000 0.0000 -0.0450"/><axis xyz="0 1 0"/><limit lower="-0.7854" upper="0.7854" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_ankle_roll" type="revolute"><parent link="r_ankle_pitch_link"/><child link="r_ankle_roll_link"/><origin xyz="0.0000 0.0000 0.0000"/><axis xyz="1 0 0"/><limit lower="-0.5236" upper="0.5236" effort="0.343" velocity="13.09"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_shoulder_roll" type="revolute"><parent link="l_shoulder_pitch_link"/><child link="l_shoulder_roll_link"/><origin xyz="0.0000 0.0050 0.0000"/><axis xyz="1 0 0"/><limit lower="-0.1745" upper="2.7925" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="l_elbow" type="revolute"><parent link="l_shoulder_roll_link"/><child link="l_elbow_link"/><origin xyz="0.0000 0.0000 -0.0500"/><axis xyz="0 1 0"/><limit lower="-2.2689" upper="0.0000" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_shoulder_roll" type="revolute"><parent link="r_shoulder_pitch_link"/><child link="r_shoulder_roll_link"/><origin xyz="0.0000 -0.0050 0.0000"/><axis xyz="1 0 0"/><limit lower="-2.7925" upper="0.1745" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="r_elbow" type="revolute"><parent link="r_shoulder_roll_link"/><child link="r_elbow_link"/><origin xyz="0.0000 0.0000 -0.0500"/><axis xyz="0 1 0"/><limit lower="-2.2689" upper="0.0000" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="head_pitch" type="revolute"><parent link="neck_yaw_link"/><child link="head_pitch_link"/><origin xyz="0.0000 0.0000 0.0220"/><axis xyz="0 1 0"/><limit lower="-0.5236" upper="0.7854" effort="0.177" velocity="10.47"/><dynamics damping="0.02" friction="0"/></joint>
  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0.0000 0.0000 0.0300" rpy="0.000000 0.000000 0.000000"/></joint>
  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed"><parent link="head_pitch_link"/><child link="camera_link"/><origin xyz="0.0310 0.0000 0.0420" rpy="0.000000 0.261799 0.000000"/></joint>
  <link name="tof_link"/>
  <joint name="tof_link_joint" type="fixed"><parent link="head_pitch_link"/><child link="tof_link"/><origin xyz="0.0310 0.0080 0.0450" rpy="0.000000 0.349066 0.000000"/></joint>
  <link name="l_mic_link"/>
  <joint name="l_mic_link_joint" type="fixed"><parent link="head_pitch_link"/><child link="l_mic_link"/><origin xyz="0.0020 0.0385 0.0240" rpy="0.000000 0.000000 1.570796"/></joint>
  <link name="r_mic_link"/>
  <joint name="r_mic_link_joint" type="fixed"><parent link="head_pitch_link"/><child link="r_mic_link"/><origin xyz="0.0020 -0.0385 0.0240" rpy="0.000000 0.000000 -1.570796"/></joint>
  <link name="l_sole"/>
  <joint name="l_sole_joint" type="fixed"><parent link="l_ankle_roll_link"/><child link="l_sole"/><origin xyz="0.0000 0.0000 -0.0250" rpy="0.000000 0.000000 0.000000"/></joint>
  <link name="r_sole"/>
  <joint name="r_sole_joint" type="fixed"><parent link="r_ankle_roll_link"/><child link="r_sole"/><origin xyz="0.0000 0.0000 -0.0250" rpy="0.000000 0.000000 0.000000"/></joint>
  <link name="l_gripper"/>
  <joint name="l_gripper_joint" type="fixed"><parent link="l_elbow_link"/><child link="l_gripper"/><origin xyz="0.0000 0.0000 -0.0440" rpy="0.000000 0.000000 0.000000"/></joint>
  <link name="r_gripper"/>
  <joint name="r_gripper_joint" type="fixed"><parent link="r_elbow_link"/><child link="r_gripper"/><origin xyz="0.0000 0.0000 -0.0440" rpy="0.000000 0.000000 0.000000"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.570796 0.000000 -1.570796"/></joint>

  <ros2_control name="mico" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="l_hip_yaw"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_hip_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_hip_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_knee"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_ankle_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_ankle_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_hip_yaw"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_hip_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_hip_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_knee"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_ankle_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_ankle_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_shoulder_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_shoulder_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="l_elbow"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_shoulder_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_shoulder_roll"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="r_elbow"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="neck_yaw"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="head_pitch"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on><update_rate>200</update_rate><topic>imu</topic><gz_frame_id>imu_link</gz_frame_id>
      <imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.039</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.039</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.039</stddev></noise></z></linear_acceleration></imu>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="head_camera" type="camera">
      <always_on>1</always_on><update_rate>30</update_rate><topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera><horizontal_fov>1.0856</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>10</far></clip><optical_frame_id>camera_optical_frame</optical_frame_id></camera>
    </sensor>
  </gazebo>

  <gazebo reference="tof_link">
    <sensor name="tof" type="gpu_lidar">
      <always_on>1</always_on><update_rate>30</update_rate><topic>tof</topic><gz_frame_id>tof_link</gz_frame_id>
      <lidar><scan><horizontal><samples>1</samples><resolution>1</resolution>
        <min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan><range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range></lidar>
    </sensor>
  </gazebo>

  <gazebo reference="l_ankle_roll_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="r_ankle_roll_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
</robot>
